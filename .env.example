# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/fraud_db

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# AWS Credentials and Integration Placeholders
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:FraudAlertsTopic
AWS_SES_SENDER_EMAIL=alerts@yourdomain.com

# TigerGraph Configuration Placeholders
TIGERGRAPH_HOST=http://localhost
TIGERGRAPH_GRAPH=FraudGraph
TIGERGRAPH_SECRET=your_tigergraph_secret_here
TIGERGRAPH_TOKEN=your_tigergraph_token_here
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=tigergraph

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8000/api/v1
