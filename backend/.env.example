# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/fraud_db

# Redis & Celery Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# AWS Integration Placeholders
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:FraudAlertsTopic
AWS_SES_SENDER_EMAIL=alerts@yourdomain.com

# Application Settings
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Fraud Rule Engine"
